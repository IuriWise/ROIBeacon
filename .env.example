# Chave da Groq para usar o modelo openai/gpt-oss-120b.
# Gere sua chave em https://console.groq.com/keys e copie este arquivo para .env.
GROQ_API_KEY=cole_sua_chave_groq_aqui

# ID da planilha de destino (trecho entre /d/ e /edit na URL do Google Sheets).
GOOGLE_SHEETS_ID=cole_o_id_da_sua_planilha_aqui
